<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZNext.Views.SettingsSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="SettingsNavigationBorder"
                Grid.Row="0"
                Margin="30,24,30,12">
            <StackPanel x:Name="SettingsTextNavigationBar"
                        MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button x:Name="SettingsHomeNavigationButton"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="SettingsHomeNavigationButton_Click"
                        ToolTipService.ToolTip="返回设置">
                    <TextBlock Text="设置"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Style="{ThemeResource TitleTextBlockStyle}"/>
                </Button>
                <TextBlock x:Name="SettingsNavigationSeparatorText"
                           Text="/"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="SettingsCurrentNavigationText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Style="{ThemeResource TitleTextBlockStyle}"/>
            </StackPanel>
        </Border>

        <Frame x:Name="SettingsContentFrame"
               Grid.Row="1"
               Background="Transparent"
               Navigated="SettingsContentFrame_Navigated">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition x:Name="SettingsNavigationTransition">
                        <EntranceNavigationTransitionInfo/>
                    </NavigationThemeTransition>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsNavigationBorder.Margin" Value="20,18,20,10"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
