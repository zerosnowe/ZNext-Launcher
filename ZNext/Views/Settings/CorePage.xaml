<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZNext.Views.Settings.CorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border x:Name="RootBorder"
                Margin="30,0,30,24">
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="4">
                <controls:SettingsExpander Header="frpc 管理"
                                           Description="核心管理与版本信息"
                                           IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE835;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing x:Name="FrpcInstallBusyRing"
                                          Width="14"
                                          Height="14"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                            <TextBlock x:Name="FrpcInstallBusyText"
                                       Text="安装中"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button x:Name="FrpcInstallButton"
                                    Content="安装核心"
                                    MinWidth="120"
                                    Click="FrpcInstallButton_Click"/>
                        </StackPanel>
                    </controls:SettingsExpander.Content>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="安装状态"
                                               Description="查看客户端核心状态">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon x:Name="FrpcStatusIcon"
                                          FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE946;"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock Text="{Binding FrpcStatusText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="查看核心目录"
                                               Description="打开核心目录">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE8B7;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <Button MinWidth="110"
                                    Click="FrpcOpenDirectoryButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                              Glyph="&#xE838;"
                                              FontSize="14"/>
                                    <TextBlock Text="打开"/>
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="启动参数"
                                               Description="配置核心启动参数">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE713;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <Button MinWidth="110"
                                    Click="LaunchArgsButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                              Glyph="&#xE713;"
                                              FontSize="14"/>
                                    <TextBlock Text="设置"/>
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootBorder.Margin" Value="20,0,20,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
