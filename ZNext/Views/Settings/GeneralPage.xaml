<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZNext.Views.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border x:Name="RootBorder"
                Margin="30,0,30,24">
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="4">
                <controls:SettingsCard Header="主题"
                                       Description="切换主题">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE771;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160"
                              SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="跟随系统"
                                      Tag="Default"/>
                        <ComboBoxItem Content="浅色"
                                      Tag="Light"/>
                        <ComboBoxItem Content="深色"
                                      Tag="Dark"/>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="背景材质"
                                       Description="切换窗口背景材质">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE727;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160"
                              SelectedValue="{Binding BackdropMaterial, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="亚克力"
                                      Tag="Acrylic"/>
                        <ComboBoxItem Content="Mica"
                                      Tag="Mica"/>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsExpander Header="自定义背景"
                                           Description="使用本地图片或 MP4 视频作为应用背景"
                                           IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xEB9F;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Content>
                        <ToggleSwitch IsOn="{Binding IsCustomBackgroundEnabled, Mode=TwoWay}"
                                      OnContent="开启"
                                      OffContent="关闭"/>
                    </controls:SettingsExpander.Content>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="背景文件"
                                               Description="{Binding CustomBackgroundDisplayText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button MinWidth="96"
                                        Click="SelectCustomBackgroundButton_Click">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                                  Glyph="&#xE8E5;"
                                                  FontSize="14"/>
                                        <TextBlock Text="选择背景"/>
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="80"
                                        Click="ClearCustomBackgroundButton_Click">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                                  Glyph="&#xE711;"
                                                  FontSize="14"/>
                                        <TextBlock Text="清除"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard Header="头像设置"
                                       Description="上传本地头像">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE77B;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button MinWidth="120"
                                Click="UploadAvatarButton_Click">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE8E5;"
                                          FontSize="14"/>
                                <TextBlock Text="上传头像"/>
                            </StackPanel>
                        </Button>
                        <Button MinWidth="100"
                                Click="ClearAvatarButton_Click">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE711;"
                                          FontSize="14"/>
                                <TextBlock Text="清除头像"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="AvatarStatusText"
                                   Text="未设置"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootBorder.Margin" Value="20,0,20,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
