<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ZNext.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border x:Name="RootBorder"
                Margin="30,0,30,24">
            <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="4">
                <controls:SettingsExpander Header="ZNext Launcher"
                                           Description="@ZeroNetwork"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-48.png"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Content>
                        <TextBlock Text="{Binding AboutVersionText}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </controls:SettingsExpander.Content>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="官方网站"
                                               Description="浏览官方网站"
                                               IsClickEnabled="True"
                                               Tag="https://znext.ccwu.cc"
                                               Tapped="ExternalLinkSettingsCard_Tapped">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE774;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE8A7;"/>
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="GitHub"
                                               Description="查看源代码"
                                               IsClickEnabled="True"
                                               Tag="https://github.com/zerosnowe/ZNext-Launcher"
                                               Tapped="ExternalLinkSettingsCard_Tapped">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE943;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE8A7;"/>
                            </controls:SettingsCard.ActionIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="开源库"
                                               Description="项目中使用到的主要开源组件">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          Glyph="&#xE943;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            MinWidth="520">
                                    <HyperlinkButton Content="Windows App SDK"
                                                     NavigateUri="https://github.com/microsoft/WindowsAppSDK"
                                                     Padding="0"/>
                                    <HyperlinkButton Content="CommunityToolkit"
                                                     NavigateUri="https://github.com/CommunityToolkit/Windows"
                                                     Padding="0"/>
                                    <HyperlinkButton Content=".NET"
                                                     NavigateUri="https://github.com/dotnet/runtime"
                                                     Padding="0"/>
                                    <HyperlinkButton Content="CsWinRT"
                                                     NavigateUri="https://github.com/microsoft/CsWinRT"
                                                     Padding="0"/>
                                    <HyperlinkButton Content="WinUI"
                                                     NavigateUri="https://github.com/microsoft/microsoft-ui-xaml"
                                                     Padding="0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard Header="TPCA联盟认证"
                                       Description="By MEFrpTPCA"
                                       IsClickEnabled="True"
                                       Tag="https://mefrp-tpca.yealqp.cn/"
                                       Tapped="ExternalLinkSettingsCard_Tapped">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/TPCA.png"/>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE8A7;"/>
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>

                <controls:SettingsCard Header="更新"
                                       Description="检测并获取更新">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  Glyph="&#xE895;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="FetchUpdateButton"
                            Content="{Binding FetchUpdateButtonText}"
                            IsEnabled="{Binding IsFetchUpdateEnabled}"
                            MinWidth="120"
                            Click="FetchUpdateButton_Click"/>
                </controls:SettingsCard>
            </StackPanel>
        </Border>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutVisualStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootBorder.Margin" Value="20,0,20,20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
