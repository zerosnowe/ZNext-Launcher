<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ZNext.Views.Dialogs.DomainWhitelistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="域名白名单"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <Button x:Name="CloseButton"
                Grid.Row="0"
                Click="CloseButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-4,-4,0"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="关闭"
                Width="32"
                Height="32">
            <FontIcon Glyph="&#xE711;"
                      FontFamily="{ThemeResource AppSymbolFontFamily}"
                      FontSize="14"/>
        </Button>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Auto"
                      MaxHeight="640">
            <StackPanel Width="480"
                        Spacing="12"
                        Padding="0,4,0,4">
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="提示"
                         Message="这里是用于「中国大陆（不含港澳台）」节点创建 HTTP/HTTPS 隧道的域名白名单，您的域名需要拥有工业和信息化部的备案记录才可添加。非中国大陆节点建站，域名无需过白。"/>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Warning"
                         Title="注意"
                         Message="在填写时，请直接填写根域名，例如 mefrp.com，不要填写 www.mefrp.com 等子域名，免费子域名请勿在此处填写。我们使用实时数据自动过白，提交无效的域名可能导致您被通报！"/>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Error"
                         Title="声明"
                         Message="ME Frp 不提供任何的域名备案服务，请自行根据服务商要求备案。"/>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind DomainCountText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Button Grid.Column="1"
                            x:Name="AddDomainButton"
                            Click="AddDomainButton_Click"
                            Padding="12,6"
                            Background="#3B82F6"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;"
                                      FontFamily="{ThemeResource AppSymbolFontFamily}"
                                      FontSize="14"/>
                            <TextBlock Text="添加域名" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView x:Name="DomainListView"
                          ItemsSource="{x:Bind DomainItems, Mode=OneWay}"
                          MaxHeight="320"
                          Visibility="{x:Bind HasDomains, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="0,6">
                                <TextBlock Text="{Binding Domain}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetailText}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Visibility="{x:Bind IsEmpty, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      Padding="0,40">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7C4;"
                                  FontFamily="{ThemeResource AppSymbolFontFamily}"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                        <TextBlock Text="暂无已添加的域名"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
