<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ZNext.Views.Dialogs.LaunchArgsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="启动参数设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Width="480" Spacing="12" Padding="0,4">
        <InfoBar IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="提示"
                 Message="启动参数将在 frpc 启动时附加到命令行末尾，请确保参数格式正确。"/>

        <TextBox x:Name="LaunchArgsTextBox"
                 Header="启动参数"
                 PlaceholderText="例如: --log_level debug"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="120"
                 HorizontalAlignment="Stretch"/>

        <TextBlock Text="常用参数示例："
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <StackPanel Spacing="4">
            <TextBlock Text="--log_level debug  启用调试日志"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="--log_max_days 7  日志保留天数"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>