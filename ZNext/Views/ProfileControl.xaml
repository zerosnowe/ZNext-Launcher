<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ZNext.Views.ProfileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:Name="ProfileButton"
            Width="36"
            Height="36"
            Padding="0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Right"
            ToolTipService.ToolTip="账户"
            Click="ProfileButton_Click"
            PointerPressed="ProfileButton_PointerPressed"
            PointerReleased="ProfileButton_PointerReleased"
            PointerCanceled="ProfileButton_PointerCanceled"
            PointerCaptureLost="ProfileButton_PointerCaptureLost"
            RenderTransformOrigin="0.5,0.5">
        <Button.RenderTransform>
            <ScaleTransform x:Name="ProfileButtonScaleTransform"
                            ScaleX="1"
                            ScaleY="1"/>
        </Button.RenderTransform>
        <Button.Flyout>
            <Flyout x:Name="SignedInProfileFlyout"
                    Placement="BottomEdgeAlignedRight">
                <StackPanel Width="240"
                            Padding="10"
                            Spacing="8">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Grid Width="36"
                              Height="36">
                            <PersonPicture x:Name="FlyoutAvatarPicture"
                                           Width="36"
                                           Height="36"
                                           Visibility="Collapsed"/>
                            <Border x:Name="FlyoutUserGlyphHost"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    Visibility="Visible">
                                <FontIcon Glyph="&#xE77B;"
                                          FontFamily="{ThemeResource AppSymbolFontFamily}"
                                          FontSize="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UsernameText"
                                       Text="未登录"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="EmailText"
                                       Text="-"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="退出登录"
                            x:Name="LogoutButton"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#0057D8"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Flyout>
        </Button.Flyout>

        <Grid Width="28"
              Height="28">
            <PersonPicture x:Name="AvatarPicture"
                           Width="28"
                           Height="28"
                           Visibility="Collapsed"/>
            <FontIcon x:Name="UserGlyph"
                      Glyph="&#xE77B;"
                      FontFamily="{ThemeResource AppSymbolFontFamily}"
                      FontSize="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </Grid>
    </Button>
</UserControl>
